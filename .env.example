# 部署环境配置示例。
#
# 用法：复制为 .env 并改成你自己的服务器。
# .env 已被 .gitignore 忽略，**不会**进仓库。
#
# 仅 scripts/deploy.py / scripts/run_remote.py / scripts/run_termux.py 读取。
# 服务本体不依赖这些变量。

# 目标主机（Termux + proot Ubuntu 的机器）
SOCIAL_INSIGHT_SSH_HOST=127.0.0.1

# SSH 端口。双层结构下两层端口不同：
#   Termux 宿主层 -> 8022（守护循环、tmux 在这层）
#   Ubuntu 容器  -> 2222（服务本体跑在这层）
SOCIAL_INSIGHT_SSH_PORT=22

# SSH 登录用户名
SOCIAL_INSIGHT_SSH_USER=your-user
